# Discord webhook: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-me

# URL репозитория GitHub для ссылок на коммиты: {GITHUB_REPO_URL}/commit/{hash}
GITHUB_REPO_URL=https://github.com/your-name/your-repo

# Telegram (опционально): бот создаётся у @BotFather (/newbot),
# бота нужно сделать АДМИНОМ канала с правом "Post messages".
# chat_id: публичный канал — @username; приватный — числовой id (test_send.py, пункт 6).
# Раскомментируйте и заполните оба параметра:
# TELEGRAM_BOT_TOKEN=1234567890:AA...ваш-токен...
# TELEGRAM_CHAT_ID=@your_channel

# Локальный тест парсера: без git и без уведомлений (true/1/yes/on)
# DRY_RUN=true